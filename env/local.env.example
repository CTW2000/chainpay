# ============================================================================
# chainpay · 本地环境变量样板
#
#   cp env/local.env.example env/local.env      # 真实文件，被 .gitignore 挡住（env/*.env）；填真实值
#   deploy/deploy.sh                            # 标准跑法：compose 的 env_file 读它，不要先 source
# 宿主上直接跑（调试；本机默认 JDK 21，本项目要 25）：set -a; . env/local.env; set +a，然后
#   JAVA_HOME=~/.local/jdk-25/Contents/Home SPRING_PROFILES_ACTIVE=worker mvn spring-boot:run
#
# 这份 .example 只放开发值和空位，绝不放真实密钥。三个数据库口令、SECRET_KEY、收款 xpub、主节点地址与热钱包私钥必填：
# 没设或留空应用就拒绝启动，好过带着人人都知道的默认值上生产、或者悄悄少了索引和付款。
# ============================================================================


# ---------------------------------------------------------------- 数据库
# 应用以普通角色 chainpay_app 连库（非超级用户、非属主，RLS 无条件生效）。
# chainpay_app 与 chainpay_system 由 db/init/01-roles.sql 在数据卷首次建库时创建；生产另设。
CHAINPAY_DB_URL=jdbc:postgresql://localhost:5433/chainpay
CHAINPAY_DB_USER=chainpay_app
CHAINPAY_DB_PASSWORD=chainpay_app_dev

# 迁移以属主身份跑（建表、改策略、授权）；属主的开发密码就是 docker-compose.yml 的 POSTGRES_PASSWORD
CHAINPAY_FLYWAY_USER=chainpay
CHAINPAY_FLYWAY_PASSWORD=chainpay_local_dev

# 系统连接：入账、结算、对账、控制面这类跨所有商户的操作以 chainpay_system（BYPASSRLS）连库
CHAINPAY_SYSTEM_DB_USER=chainpay_system
CHAINPAY_SYSTEM_DB_PASSWORD=chainpay_system_dev


# ---------------------------------------------------------------- Redis（限流计数、防重放的 nonce）
# compose 把它绑在 127.0.0.1:6380。挂了应用不死：限流降级为进程内计数，防重放放行、靠幂等键兜底
CHAINPAY_REDIS_HOST=localhost
CHAINPAY_REDIS_PORT=6380


# ---------------------------------------------------------------- 密钥（必填，故意无默认值）
# 加密 API secret 用的 AES-256 密钥：Base64 的 32 字节。生成：openssl rand -base64 32
CHAINPAY_SECRET_KEY=

# 建第一个管理员的口令只属于 --create-admin 那一条一次性命令：用 read -rs 读进环境变量再交给容器，
# 不写在这里（这份文件整份进容器环境），也不写在命令行上（会进 shell 历史）。完整写法见 docs/runbook/ops.md「控制面」
#   CHAINPAY_ADMIN_PASSWORD=     ← 不要在这里填


# ---------------------------------------------------------------- HTTP
# 8095：flow-pay 后端占着 8090
CHAINPAY_PORT=8095
# 管理端口：健康探针与指标只在这里答，只绑 127.0.0.1；主端口上没有 /actuator
CHAINPAY_MANAGEMENT_PORT=8096
# 主端口监听地址：默认只本机。容器里 compose 设成 0.0.0.0，这里不用改
CHAINPAY_BIND_ADDRESS=127.0.0.1
# 日志级别：开发看每一步用 DEBUG；DEBUG 会把地址、金额打进日志，别带上生产
CHAINPAY_LOG_LEVEL=DEBUG


# ---------------------------------------------------------------- 告警（可选）
# 出口是一个 webhook；不设 = 变化只打 ERROR 日志。URL 按口令对待（Slack / 钉钉 / 飞书的令牌就在 URL 里），日志里只出主机名。
# 容器里打宿主上的接收端写 http://host.docker.internal:<端口>/...
CHAINPAY_ALERT_WEBHOOK_URL=
# 载荷形状：generic（自己的接收端）/ slack / dingtalk / feishu
CHAINPAY_ALERT_FORMAT=generic


# ---------------------------------------------------------------- 链（主节点必填，其余可选）
# 主节点：索引、入账、对账、发送都要问它，没设或留空就拒绝启动。key 就在 URL 里，整条按口令对待：
#   https://eth-sepolia.g.alchemy.com/v2/<API key>
# 别用免 key 的 publicnode 当主节点：它限流时回 HTTP 403，客户端把 401 / 403 当凭证失效，索引、入账、付款会一起停下
CHAINPAY_CHAIN_RPC_URL=

# 审计节点：对账和 finalized 核对走它。必须和主节点是不同的主机（同一家的两台机器会被同一个 bug 骗过；同主机应用拒绝启动）。
# 免 key 且支持回执查询的：https://sepolia.gateway.tenderly.co。不设 = 单节点（启动日志写明），抓得住漏日志，抓不住节点整体撒谎
CHAINPAY_CHAIN_AUDIT_RPC_URL=

# 没有书签时从哪个块开始（该块视为已处理）。不设 = 没书签就停下，不猜。首次启动前查当前高度，填一个稍早的数
CHAINPAY_CHAIN_START_BLOCK=


# ---------------------------------------------------------------- 收款（必填）
# 账户层 xpub（m/44'/60'/0'），收款地址都从它派生：没配或留空应用就拒绝启动。断网跑 tools/xpub.sh 从测试网助记词算出来，前三个地址必须和钱包一致。
# xpub 转不走钱，但能枚举全部收款地址，按敏感信息对待
CHAINPAY_DEPOSIT_XPUB=


# ---------------------------------------------------------------- 付款（必填）
# 热钱包私钥：0x + 64 位十六进制，没设或留空就拒绝启动。断网跑 tools/hotwallet.sh，从另一句助记词或同一句的硬化账户
# m/44'/60'/1'/0/0 算出；绝不能是收款树的普通派生子私钥（xpub 加任意一个子私钥 = 父私钥）。只在这个文件与进程内存里
CHAINPAY_PAYOUT_HOT_WALLET_KEY=


# ---------------------------------------------------------------- 测试探针的节点地址在 env/probe.env.example
# 这份文件整份进容器环境（compose 的 env_file），应用从不读探针地址：放在这里等于白送容器两把带 key 的钥匙（EnvInventoryTest 守）
