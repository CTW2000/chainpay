# ============================================================================
# chainpay · 本地环境变量样板
#
# 用法：
#   cp env/local.env.example env/local.env      # 真实文件，已被 .gitignore 挡住（env/*.env）
#   set -a; source env/local.env; set +a         # 把里面的变量导出到当前 shell
#   JAVA_HOME=~/.local/jdk-25/Contents/Home mvn spring-boot:run
#
# 规矩（同 CLAUDE.md §6）：
#   · 这个 .example 里只放开发值和空位，绝不放真实密钥、API key、生产密码
#   · env/local.env 才放真实值，它永远不进 git
#   · 四个「故意不给默认值」的变量不设应用直接起不来——那是刻意的：
#     配错了就起不来，远好过带着一个人人都知道的默认值上生产
# ============================================================================


# ---------------------------------------------------------------- 数据库
# 应用以普通角色 chainpay_app 连库（不是超级用户、不是表的所有者，RLS 无条件生效）。
# 角色和这个开发密码由 db/init/01-roles.sql 在容器首次建库时创建；生产由 DBA 另设。
CHAINPAY_DB_URL=jdbc:postgresql://localhost:5433/chainpay
CHAINPAY_DB_USER=chainpay_app
CHAINPAY_DB_PASSWORD=chainpay_app_dev

# Flyway 以属主身份跑迁移（建表、改策略、授权），和运行时的普通角色分开。
# 属主的开发密码在 docker-compose.yml 的 POSTGRES_PASSWORD 里。
CHAINPAY_FLYWAY_USER=chainpay
CHAINPAY_FLYWAY_PASSWORD=chainpay_local_dev

# 系统连接（M3-⓪）：入账、结算这类无人值守、跨所有商户动钱的任务以 chainpay_system 连库。
# 它带 BYPASSRLS：系统权限是连接身份，不再是 Java 里一个谁都能调的开关。密码同样故意没有默认值。
# 角色由 db/init/01-roles.sql 创建；已有的开发库卷要手工补一次，见 README「把应用跑起来」。
CHAINPAY_SYSTEM_DB_USER=chainpay_system
CHAINPAY_SYSTEM_DB_PASSWORD=chainpay_system_dev


# ---------------------------------------------------------------- Redis（限流计数）
# docker-compose 把它绑在 127.0.0.1:6380。Redis 挂了限流会降级为进程内计数，应用不死。
CHAINPAY_REDIS_HOST=localhost
CHAINPAY_REDIS_PORT=6380


# ---------------------------------------------------------------- 密钥（必填，故意无默认值）
# 加密 API secret 用的 AES-256 密钥：Base64 的 32 字节。生成：
#   openssl rand -base64 32
CHAINPAY_SECRET_KEY=

# M6-⑤ 起控制面用管理员会话，不再有静态令牌。第一个管理员这样建（口令只在这一条命令的环境里，不进参数、不进文件）：
#   CHAINPAY_ADMIN_PASSWORD='至少 12 位' docker compose run --rm --no-deps -e CHAINPAY_ADMIN_PASSWORD app --create-admin ops
# 之后 tools/admin.sh login ops 登录、tools/admin.sh reauth 再认证。


# ---------------------------------------------------------------- HTTP
# 8095 而不是 8090：flow-pay 后端占 8090，两个项目同时开着会撞
CHAINPAY_PORT=8095
# M6-⓪ 管理端口：健康探针与指标只在这个端口上答，且只绑 127.0.0.1；主端口上没有 /actuator
CHAINPAY_MANAGEMENT_PORT=8096
# M6-② 主端口监听地址：默认 127.0.0.1（只本机）。容器里由 compose 设成 0.0.0.0，这里不用改
CHAINPAY_BIND_ADDRESS=127.0.0.1
# M6-② 日志级别：默认 INFO。开发想看每一步时改 DEBUG；DEBUG 会把地址、金额打进日志，别带上生产
CHAINPAY_LOG_LEVEL=DEBUG


# ---------------------------------------------------------------- 告警（M6-③，可选）
# 出口：一个 HTTP webhook。不设 = 变化只打 ERROR 日志。URL 按密码对待（Slack / 钉钉 / 飞书的入站 webhook 令牌就在 URL 里），日志里只出主机名。
# 容器里打宿主上的接收端写 http://host.docker.internal:<端口>/...
CHAINPAY_ALERT_WEBHOOK_URL=
# 载荷形状：generic（自己的接收端）/ slack / dingtalk / feishu
CHAINPAY_ALERT_FORMAT=generic


# ---------------------------------------------------------------- 链（M2 起，全部可选）
# 主节点。不设 = 索引器整个不装配，应用照常启动（账本和 API 不该因为链节点没配而起不来）。
# 免 key：https://ethereum-sepolia-rpc.publicnode.com（会限流，连续几十次请求 403）
# Alchemy：https://eth-sepolia.g.alchemy.com/v2/<你的 API key>  ← key 就在 URL 里，整条 URL 按密码对待
CHAINPAY_CHAIN_RPC_URL=

# 审计节点（M2-⑤）：对账和 finalized 核对走它。
# 要独立于主节点才有价值：同一家的两台机器会被同一个 bug 骗过。
# 免 key 且支持回执查询的：https://sepolia.gateway.tenderly.co
# 不设 = 退化为主节点自己的回执路径，能抓索引漏日志，抓不住节点整体撒谎。
# 必须和主节点是不同的主机：同一家的两把 key 不算独立，应用会拒绝启动。不配则退化为单节点（启动日志会说明）
CHAINPAY_CHAIN_AUDIT_RPC_URL=

# ---------------------------------------------------------------- 收款（M3）
# 账户层 xpub（m/44'/60'/0'）。不设 = 收款模块不装配。断网跑 tools/xpub.sh 从你的测试网助记词算出来，
# 前三个地址必须和 MetaMask 一致。xpub 不是私钥（转不走钱），但能枚举你全部收款地址，按敏感信息对待。
CHAINPAY_DEPOSIT_XPUB=

# 没有书签时从哪个块开始（该块视为已处理）。不设 = 没书签就停下，不猜。
# 首次启动前去浏览器查一下当前高度，填一个稍早的数。
# （对应 application.yml 的 chainpay.chain.start-block，Spring 会自动把这个变量名映射过去）
CHAINPAY_CHAIN_START_BLOCK=


# ---------------------------------------------------------------- 付款（M4）
# 热钱包私钥：0x + 64 位十六进制。不设 = 付款模块不装配。断网跑 tools/hotwallet.sh，从「另一句」助记词
# 或与收款树同一句的硬化账户 1' 算出（m/44'/60'/1'/0/0）。绝不能是收款树（CHAINPAY_DEPOSIT_XPUB 那一支）的普通派生子密钥：
# xpub 加任意一个子私钥 = 父私钥 = 全部收款地址。按真密钥对待：只在这个文件与进程内存里，不进参数、日志、镜像。
# tools/check-secrets.sh 会扫仓库里有没有它的影子。
CHAINPAY_PAYOUT_HOT_WALLET_KEY=
# ---------------------------------------------------------------- 测试探针的节点地址不在这里
# 挪到了 env/probe.env.example（进程拆分 ①）：这份文件整份进容器的环境（docker-compose.yml 的 env_file），
# 应用从不读探针的地址，放在这里就是给容器白送两把带 key 的钥匙。EnvInventoryTest 守着。


# ---------------------------------------------------------------- 不是应用读的，但 mvn 需要
# 这台机器的 shell 默认指向 jdk-21（flow-pay 用），本项目要 25：
#   export JAVA_HOME=~/.local/jdk-25/Contents/Home
