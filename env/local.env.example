# ============================================================================
# chainpay · 本地环境变量样板
#
# 用法：
#   cp env/local.env.example env/local.env      # 真实文件，已被 .gitignore 挡住（env/*.env）
#   set -a; source env/local.env; set +a         # 把里面的变量导出到当前 shell
#   JAVA_HOME=~/.local/jdk-25/Contents/Home mvn spring-boot:run
#
# 规矩（同 CLAUDE.md §6）：
#   · 这个 .example 里只放开发值和空位，绝不放真实密钥、API key、生产密码
#   · env/local.env 才放真实值，它永远不进 git
#   · 三个「故意不给默认值」的变量不设应用直接起不来——那是刻意的：
#     配错了就起不来，远好过带着一个人人都知道的默认值上生产
# ============================================================================


# ---------------------------------------------------------------- 数据库
# 应用以普通角色 chainpay_app 连库（不是超级用户、不是表的所有者，RLS 无条件生效）。
# 角色和这个开发密码由 db/init/01-roles.sql 在容器首次建库时创建；生产由 DBA 另设。
CHAINPAY_DB_URL=jdbc:postgresql://localhost:5433/chainpay
CHAINPAY_DB_USER=chainpay_app
CHAINPAY_DB_PASSWORD=chainpay_app_dev

# Flyway 以属主身份跑迁移（建表、改策略、授权），和运行时的普通角色分开。
# 属主的开发密码在 docker-compose.yml 的 POSTGRES_PASSWORD 里。
CHAINPAY_FLYWAY_USER=chainpay
CHAINPAY_FLYWAY_PASSWORD=chainpay_local_dev


# ---------------------------------------------------------------- Redis（限流计数）
# docker-compose 把它绑在 127.0.0.1:6380。Redis 挂了限流会降级为进程内计数，应用不死。
CHAINPAY_REDIS_HOST=localhost
CHAINPAY_REDIS_PORT=6380


# ---------------------------------------------------------------- 密钥（必填，故意无默认值）
# 加密 API secret 用的 AES-256 密钥：Base64 的 32 字节。生成：
#   openssl rand -base64 32
CHAINPAY_SECRET_KEY=

# 控制面 /admin/** 的管理员令牌，至少 32 个字符。生成：
#   openssl rand -hex 32
# 它是一把能给任意商户发钥匙的万能令牌；另一层防线是「只接受本机回环地址」。
CHAINPAY_ADMIN_TOKEN=


# ---------------------------------------------------------------- HTTP
# 8095 而不是 8090：flow-pay 后端占 8090，两个项目同时开着会撞
CHAINPAY_PORT=8095


# ---------------------------------------------------------------- 链（M2 起，全部可选）
# 主节点。不设 = 索引器整个不装配，应用照常启动（账本和 API 不该因为链节点没配而起不来）。
# 免 key：https://ethereum-sepolia-rpc.publicnode.com（会限流，连续几十次请求 403）
# Alchemy：https://eth-sepolia.g.alchemy.com/v2/<你的 API key>  ← key 就在 URL 里，整条 URL 按密码对待
CHAINPAY_CHAIN_RPC_URL=

# 审计节点（M2-⑤）：对账和 finalized 核对走它。
# 要独立于主节点才有价值：同一家的两台机器会被同一个 bug 骗过。
# 免 key 且支持回执查询的：https://sepolia.gateway.tenderly.co
# 不设 = 退化为主节点自己的回执路径，能抓索引漏日志，抓不住节点整体撒谎。
# 必须和主节点是不同的主机：同一家的两把 key 不算独立，应用会拒绝启动。不配则退化为单节点（启动日志会说明）
CHAINPAY_CHAIN_AUDIT_RPC_URL=

# 没有书签时从哪个块开始（该块视为已处理）。不设 = 没书签就停下，不猜。
# 首次启动前去浏览器查一下当前高度，填一个稍早的数。
# （对应 application.yml 的 chainpay.chain.start-block，Spring 会自动把这个变量名映射过去）
CHAINPAY_CHAIN_START_BLOCK=


# ---------------------------------------------------------------- 只有测试探针用
# 设了才会跑 SepoliaProbeTest / SepoliaIndexProbeTest（默认测试集必须离线）。
#   CHAINPAY_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com \
#   CHAINPAY_SEPOLIA_AUDIT_RPC=https://sepolia.gateway.tenderly.co \
#   mvn test -Dtest='SepoliaProbeTest,SepoliaIndexProbeTest'
CHAINPAY_SEPOLIA_RPC=
CHAINPAY_SEPOLIA_AUDIT_RPC=


# ---------------------------------------------------------------- 不是应用读的，但 mvn 需要
# 这台机器的 shell 默认指向 jdk-21（flow-pay 用），本项目要 25：
#   export JAVA_HOME=~/.local/jdk-25/Contents/Home
