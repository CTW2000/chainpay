<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 4.1.0（Spring Framework 7.0.x），Java 25。4.x 的示例还少，和 3.x 写法不同是正常的；踩过的版本坑见 README 末尾 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.chainpay</groupId>
    <artifactId>chainpay</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>chainpay</name>
    <description>加密支付网关 —— 学习项目</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JDBC 而不是 JPA：账本层要看得见每一条 SQL（JdbcClient 在 spring-jdbc 里） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 健康检查与指标：分组、探针、HTTP 状态映射、连接池与 Redis 的指示器引库；
             每个指示器判「什么算能干活」是业务，自己写（com.chainpay.ops.health）。端点只在回环的管理端口上答 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 管理员口令散列用 Argon2id（Spring Security 的 crypto 模块，不引整个 Security；实现来自下面的 BouncyCastle）。
             谁能登录、会话多久、什么算敏感操作是业务，自己写（com.chainpay.admin） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Redis：限流计数与防重放的 nonce 要在所有实例之间共享（进程内计数扩到两个实例，商户就能打两倍）。
             客户端是 Lettuce：线程安全，一个连接所有线程共用，不需要连接池 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 迁移，三个都要：spring-boot-flyway 是 Boot 4 拆出来的自动配置，缺了迁移静默不跑（README 版本坑 2）；
             flyway-database-postgresql 是 Flyway 10+ 按数据库拆的模块，缺了运行时报不支持 postgresql -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 密码学原语：secp256k1、Keccak-256、RIPEMD-160、Argon2。BIP-32 / 39、EIP-55 自己写、用规范向量钉住（CLAUDE.md §7）。
             版本跟 web3j 6.0.0 声明的一致：钉得更旧，Maven 就近优先会把 web3j 压到比它编译时更旧的 BC 上 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>
        <!-- 协议编码用库：web3j 只拿 crypto 模块（RLP、EIP-1559 编码、签名与恢复、地址），不拿 core（JSON-RPC 客户端自己写，里面全是策略）。
             排除 jc-kzg-4844：EIP-4844 blob 交易的原生库，我们不发那种交易，付款系统不带用不上的原生库（前提：Eip1559Transaction.decode 只放行首字节 0x02） -->
        <dependency>
            <groupId>org.web3j</groupId>
            <artifactId>crypto</artifactId>
            <version>6.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>io.consensys.protocols</groupId>
                    <artifactId>jc-kzg-4844</artifactId>
                </exclusion>
                <!-- tuweni 把 vert.x、netty 编解码器、kotlin-stdlib、Jackson 2 拖进运行时（约 5.7 MB，仓里零引用）。
                     前提：只调 TransactionEncoder / TransactionDecoder / Sign / Keys，不碰以 tuweni Bytes 为参数的方法；升 web3j 时复查 -->
                <exclusion>
                    <groupId>io.consensys.tuweni</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===== 测试 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试跑真 PostgreSQL 18，不用 H2：NUMERIC 语义、隔离级别、锁行为都不一样，而这三处正好是本项目最要命的地方 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x 的坐标带 testcontainers- 前缀（README 版本坑 1） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试跑真 Redis（Lua 脚本的原子性桩模拟不了）。groupId 是 com.redis：Redis 官方维护的模块，不在 Testcontainers 的 BOM 里，版本由 Boot 托管 -->
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
